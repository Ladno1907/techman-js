{
  "name": "techman-js",
  "version": "2.0.2",
  "author": "Ladno",
  "license": "MIT",
  "description": "TypeScript library for Techman Robot industrial automation via TCP/IP",
  "keywords": [
    "techman",
    "robotics",
    "TMFlow",
    "tcp/ip",
    "typescript"
  ],
  "type": "module",

  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],

  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:table": "vitest run --coverage --reporter=default",
    "test:ui": "vitest --ui --coverage",
    "prepublishOnly": "npm run lint && npm run test:run && npm run build",
    "clear": "rimraf dist coverage"
  },

  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.5",
    "vitest": "^4.1.2"
  }
}
